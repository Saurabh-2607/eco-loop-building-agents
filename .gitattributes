# Handle line endings automatically for files detected as text
* text=auto

# Declare files that must always use Unix line endings (LF)
*.sh text eol=lf
*.py text eol=lf
*.js text eol=lf
*.jsx text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.md text eol=lf
.gitignore text eol=lf
.editorconfig text eol=lf
.prettierrc text eol=lf
Caddyfile text eol=lf

# Denotate binary formats (avoid Git trying to modify line endings)
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.epw binary
*.idf binary
